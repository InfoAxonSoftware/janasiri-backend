<?xml version="1.0" encoding="utf-8"?>
<!--
  Base web.config for IIS/MonsterASP hosting (ASP.NET Core Module V2, in-process).
  %LAUNCHER_PATH% and %LAUNCHER_ARGS% are filled in automatically by `dotnet publish`
  for a framework-dependent deployment (processPath -> "dotnet", arguments -> the app DLL),
  so this file does not need to hardcode the .NET 10 executable path.

  No secrets belong in this file. All configuration is read from appsettings.json /
  appsettings.Production.json / environment variables by the ASP.NET Core app itself.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
