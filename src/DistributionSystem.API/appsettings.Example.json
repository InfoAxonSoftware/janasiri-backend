{
  "_comment": "Template only. Placeholders throughout — never fill this file with real values. Use `dotnet user-secrets` locally or environment variables in production instead (see CONFIGURATION_SETUP.md).",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<db-host>;Database=<db-name>;Username=<db-user>;Password=<REPLACE_ME>"
  },
  "JwtSettings": {
    "Secret": "<REPLACE_ME_MIN_32_BYTES>",
    "Issuer": "DistributionSystem",
    "Audience": "DistributionSystemClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "SecuritySettings": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "SmtpSettings": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "<REPLACE_ME>",
    "Password": "<REPLACE_ME>",
    "FromEmail": "noreply@example.com",
    "FromName": "Distribution System",
    "AdminEmail": "admin@example.com",
    "EnableSsl": true
  },
  "DefaultSettings": {
    "CustomerCreditLimit": 50000,
    "DefaultReportDaysRange": 30,
    "TopProductsCount": 5
  },
  "DatabaseSettings": {
    "AutoMigrateOnStartup": false,
    "SeedDataOnStartup": false,
    "SeedSuperAdminOnStartup": false
  },
  "SuperAdminSeed": {
    "Username": "<REPLACE_ME>",
    "Email": "<REPLACE_ME>",
    "Password": "<REPLACE_ME>",
    "PhoneNumber": "<REPLACE_ME>",
    "FullName": "<REPLACE_ME>",
    "Department": "<REPLACE_ME>"
  },
  "SwaggerContact": {
    "Name": "Your Company",
    "Email": "support@example.com"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": [
    "https://your-frontend-domain.example.com"
  ],
  "FileStorage": {
    "RootPath": "<REPLACE_ME_PERSISTENT_ABSOLUTE_PATH_OUTSIDE_THE_APP_FOLDER>",
    "PublicDirectory": "public",
    "PrivateDirectory": "private",
    "PublicRequestPath": "/uploads",
    "MaxFileSizeBytes": 10485760
  }
}
