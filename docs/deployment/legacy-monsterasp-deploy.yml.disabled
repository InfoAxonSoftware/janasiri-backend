name: Deploy to MonsterASP

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Restore
        run: dotnet restore src/DistributionSystem.API/DistributionSystem.API.csproj

      - name: Publish
        run: dotnet publish src/DistributionSystem.API/DistributionSystem.API.csproj -c Release -o ./publish_output --runtime win-x86 --self-contained false

      - name: Deploy via FTP
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: site60153.siteasp.net
          username: site60153
          password: ${{ secrets.FTP_PASSWORD }}
          local-dir: ./publish_output/
          server-dir: /wwwroot/