# API runtime
ASPNETCORE_ENVIRONMENT=Production

# Database (use external DB in production)
CONNECTION_STRING=Host=YOUR_DB_HOST;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;
POSTGRES_DB=DistributionDB
POSTGRES_USER=openpg
POSTGRES_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_ISSUER=DistributionSystem
JWT_AUDIENCE=DistributionSystemClients
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Startup behavior
DB_AUTOMIGRATE=true
DB_SEED_DATA=false
DB_SEED_SUPERADMIN=true

# Super admin seed
SUPERADMIN_SEED_USERNAME=superadmin
SUPERADMIN_SEED_EMAIL=superadmin@example.com
SUPERADMIN_SEED_PASSWORD=REPLACE_ME_STRONG_PASSWORD
SUPERADMIN_SEED_PHONE=+10000000000
SUPERADMIN_SEED_FULLNAME=System Administrator
SUPERADMIN_SEED_DEPARTMENT=IT

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Distribution System
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_ENABLE_SSL=true

# CORS
CORS_ORIGIN_0=https://your-frontend-domain.com
CORS_ORIGIN_1=https://www.your-frontend-domain.com
